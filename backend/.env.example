APP_ENV=development
DATABASE_PATH=./data/fincept.sqlite3
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
SESSION_HOURS=8
REMEMBER_DAYS=30
# In production: APP_ENV=production, COOKIE_SECURE=true, HTTPS, exact frontend origins.
# No JWT/session signing secret is needed: opaque random sessions are stored hashed server-side.

# Optional AI Assistant: server-side only. Missing values keep the rest of the app usable.
# Select a Chat Completions model supporting native tools and max_completion_tokens.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
# Set AI_PROVIDER=openai, AI_MODEL to your enabled model ID, and OPENAI_API_KEY privately.
# apmix uses its OpenAI-compatible endpoint so FINCEPT's reviewed native tools remain available:
# AI_PROVIDER=apmix
# AI_MODEL=claude-sonnet-5
# APMIX_API_KEY=your-private-apmix-key
# Do not put these values in VITE_ variables, commit .env files, or share real keys in chat.
# Optional paid integration test only: RUN_LIVE_AI_TEST=1 (never needed for normal startup).
